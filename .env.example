# Copy to `.env` at the repo root and fill in real values. One file serves
# docker compose AND the backend (it reads this file too; an optional
# backend/.env layered on top wins). Nothing marked "changethis" is safe
# outside local development — the backend refuses to boot in
# staging/production while any secret still looks like a placeholder.

# --- Compose / deployment ------------------------------------------------
COMPOSE_PROJECT_NAME=app
# Used by docker-compose.traefik.yml only.
DOMAIN=localhost
ACME_EMAIL=you@example.com

# --- App -------------------------------------------------------------------
APP_NAME=App
APP_VERSION=0.1.0
DEBUG=True
# local | test | staging | production. docker-compose.override.yml forces
# `local`, docker-compose.traefik.yml forces `production`.
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000
# Comma-separated, no spaces. Not needed when one domain serves both the
# frontend and /api (the Traefik setup) — only for a separate frontend origin.
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Database --------------------------------------------------------------
# `localhost` for running the backend on your machine; compose overrides it
# to the `db` service inside the container network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis
# Tests only. Must differ from POSTGRES_DB — the suite drops every table in
# it on each run. The dev compose setup creates it for you.
TEST_DB=app_test

# --- Auth ------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
ALGORITHM=HS256
# Short, because refresh tokens exist: a leaked access token dies quickly.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Optional first admin, created by scripts/prestart.sh if missing. Both must
# be set. Never resets or promotes an existing account.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

# --- Email -----------------------------------------------------------------
# console (default: logs instead of sending), resend, or smtp.
# docker-compose.override.yml switches the dev stack to smtp -> Mailpit
# (http://localhost:8025) so you can read the emails the app "sends".
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=App
# Required — the app refuses to boot without it — if EMAIL_PROVIDER=resend.
RESEND_API_KEY=
# Required if EMAIL_PROVIDER=smtp. TLS = STARTTLS (587); SSL = implicit TLS
# (465); never both. Any provider's SMTP relay works.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_SSL=false

# --- OTP (email verification / password reset / 2FA) -------------------------
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Asking for another code while a fresh one is outstanding does nothing, so
# the public verify/forgot-password endpoints can't be used to flood an inbox.
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Housekeeping: `python -m app.cleanup` (run it on a schedule) -----------
# Never-verified accounts are removed after this many days.
UNVERIFIED_USER_TTL_DAYS=7
# Blank = keep audit logs forever (the default). Deleting them is a policy call.
AUDIT_LOG_RETENTION_DAYS=

# --- Google sign-in --------------------------------------------------------
# Leave blank to disable: /auth/google/login then fails with a logged 500.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match a redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Observability -----------------------------------------------------------
SERVICE_NAME=backend
LOG_LEVEL=INFO
# Blank = auto: JSON everywhere except ENVIRONMENT=local. Set true/false to force.
LOG_JSON=
# Never initializes when ENVIRONMENT=local, even if set.
SENTRY_DSN=
# Off by default — no collector needed locally.
OTEL_ENABLED=False
OTEL_EXPORTER_OTLP_ENDPOINT=
# Only relevant once agent/LLM-calling code exists in the project.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
